PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/cafesriisha?retryWrites=true&w=majority

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Base URL for building uploaded file links (images/videos).
# Set to your production domain (e.g. https://example.com) when deploying.
BASE_URL=http://localhost:8000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# SmartPing SMS (phone OTP login)
SMARTPING_USERNAME=
SMARTPING_PASSWORD=
SMARTPING_SENDER_ID=
SMARTPING_DLT_CONTENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Play review account — fixed, non-expiring OTP so reviewers aren't
# blocked behind an inbox they can't access. Must match the email/OTP entered
# in Play Console > App content > Sign in details.
PLAY_REVIEW_EMAIL=
PLAY_REVIEW_OTP=

# Flash (uEngage) Delivery API
FLASH_BASE_URL=
FLASH_STORE_ID=
FLASH_ACCESS_TOKEN=
FLASH_WEBHOOK_TOKEN=

# Petpooja POS Integration (see petpujaintregation.md)
# app_key/app_secret come from Petpooja's onboarding email (prod) or the
# dashboard Configuration tab (sandbox). Per-restaurant restID/accessToken
# are linked via POST /restaurant/petpooja/link, not env vars.
# Production base is https://pponlineordercb.petpooja.com
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_SAVE_ORDER_URL=https://pponlineordercb.petpooja.com/save_order
PETPOOJA_UPDATE_STATUS_URL=https://pponlineordercb.petpooja.com/update_order_status
# Optional — nothing calls this yet; orders relay fine without it.
PETPOOJA_RIDER_STATUS_URL=https://pponlineordercb.petpooja.com/rider_status_update
# Deprecated (Petpooja pushes the menu to our webhook); nothing reads this.
PETPOOJA_MENU_URL=
PETPOOJA_WEBHOOK_TOKEN=
